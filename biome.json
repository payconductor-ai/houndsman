{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "off",
				"useSortedKeys": "off",
				"useSortedProperties": "off"
			}
		}
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 90
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"useImportType": "error"
			},
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": ["src/server/styles.css"],
			"formatter": { "enabled": false },
			"linter": { "enabled": false }
		}
	],
	"root": true,
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
