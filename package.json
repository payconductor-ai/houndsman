{
	"name": "@payconductor/houndsman",
	"version": "0.17.0",
	"description": "Orquestrador de revisão de Pull Requests: classifica o diff, despacha watchdogs especializados por domínio e consolida o relatório.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"houndsman": "./src/cli/index.ts"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"assets",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/payconductor-ai/houndsman.git"
	},
	"bugs": {
		"url": "https://github.com/payconductor-ai/houndsman/issues"
	},
	"homepage": "https://github.com/payconductor-ai/houndsman#readme",
	"author": "PayConductor",
	"keywords": [
		"pull-request",
		"code-review",
		"cli",
		"bun",
		"ai-agents",
		"orchestrator"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"houndsman": "bun run ./src/cli/index.ts",
		"build": "bun build ./src/cli/index.ts --target bun --outdir dist",
		"test": "bun test ./src/tests",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome format --write .",
		"ci": "biome ci . && tsc -b",
		"ci:check": "biome check",
		"ci:check:fix": "biome check --fix",
		"ci:fix": "bun run ci:check:fix && bun run ci:format:fix",
		"ci:format": "biome format",
		"ci:format:fix": "biome format --fix",
		"grammars:sync": "bun run ./scripts/sync-grammars.ts"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "3.0.67",
		"ai": "7.0.143",
		"axios": "^1.12.2",
		"chalk": "^6.0.1",
		"ora": "^9.4.1",
		"preact": "^11.0.1",
		"web-tree-sitter": "0.27.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@vscode/tree-sitter-wasm": "0.3.1",
		"bun-types": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
